{
  "Logging": { "SeqUrl": "" },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173" ]
  },
  "ReverseProxy": {
    "Routes": {
      "auth": { "ClusterId": "auth", "Match": { "Path": "/api/auth/{**catch-all}" } },
      "oauth": { "ClusterId": "auth", "Match": { "Path": "/connect/{**catch-all}" } },
      "oidc": { "ClusterId": "auth", "Match": { "Path": "/.well-known/{**catch-all}" } },
      "users": { "ClusterId": "users", "Match": { "Path": "/api/users/{**catch-all}" } },
      "roles": { "ClusterId": "roles", "Match": { "Path": "/api/roles/{**catch-all}" } },
      "audit": { "ClusterId": "audit", "Match": { "Path": "/api/audit/{**catch-all}" } },
      "ai": {
        "ClusterId": "ai",
        "Match": { "Path": "/api/ai/{**catch-all}" }
      }
    },
    "Clusters": {
      "auth": { "Destinations": { "d1": { "Address": "http://auth-service:8080" } } },
      "users": { "Destinations": { "d1": { "Address": "http://user-service:8080" } } },
      "roles": { "Destinations": { "d1": { "Address": "http://role-service:8080" } } },
      "audit": { "Destinations": { "d1": { "Address": "http://audit-service:8080" } } },
      "ai": {
        "Destinations": { "d1": { "Address": "http://ai-service:8080" } },
        "HttpRequest": { "ActivityTimeout": "00:05:00" }
      }
    }
  }
}
