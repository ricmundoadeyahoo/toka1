{
  "Logging": {
    "SeqUrl": ""
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Redis": "redis:6379"
  },
  "Jwt": {
    "Issuer": "http://auth-service:8080",
    "Audience": "toka-api",
    "Authority": "http://auth-service:8080",
    "RequireHttpsMetadata": false
  },
  "RabbitMq": {
    "Host": "rabbitmq",
    "UserName": "guest",
    "Password": "guest"
  },
  "Llm": {
    "Chat": {
      "BaseUrl": "https://api.deepseek.com",
      "ApiKey": "",
      "Model": "deepseek-flash",
      "ExtraBodyJson": ""
    },
    "Embeddings": {
      "BaseUrl": "http://ollama:11434/v1",
      "ApiKey": "ollama",
      "Model": "nomic-embed-text",
      "ExtraBodyJson": ""
    },
    "MaxConcurrency": 4,
    "QueueTimeoutSeconds": 30,
    "AttemptTimeoutSeconds": 60
  },
  "Agent": {
    "TopK": 4,
    "MinRelevanceScore": 0.45,
    "MaxContextTokens": 1500,
    "MaxToolIterations": 3,
    "MaxToolOutputChars": 2000,
    "MaxQuestionLength": 1000,
    "MaxAnswerTokens": 512,
    "Temperature": 0.2,
    "ToolsEnabled": true,
    "CacheMinutes": 60,
    "ChunkSize": 900,
    "ChunkOverlap": 150,
    "RequestsPerMinutePerUser": 10,
    "Pricing": {
      "Name": "deepseek-flash (tarifa pico)",
      "InputPerMillionUsd": 0.3,
      "CachedInputPerMillionUsd": 0.006,
      "OutputPerMillionUsd": 1.2,
      "EmbeddingPerMillionUsd": 0
    },
    "ReferencePricing": {
      "Name": "gpt-4o-mini (referencia)",
      "InputPerMillionUsd": 0.15,
      "CachedInputPerMillionUsd": 0.075,
      "OutputPerMillionUsd": 0.6,
      "EmbeddingPerMillionUsd": 0.02
    }
  },
  "Qdrant": {
    "BaseUrl": "http://qdrant:6333",
    "Collection": "toka_knowledge"
  },
  "Mongo": {
    "ConnectionString": "mongodb://mongo:27017",
    "Database": "ai_db",
    "MetricsCollection": "query_metrics"
  },
  "Knowledge": {
    "Path": "/app/knowledge",
    "EvaluationDatasetPath": "/app/knowledge/eval/dataset.json",
    "IngestOnStartup": true
  },
  "Services": {
    "UserService": "http://user-service:8080",
    "RoleService": "http://role-service:8080",
    "AuditService": "http://audit-service:8080"
  }
}