# =============================================================================================
#  Copia este archivo como .env:   Copy-Item .env.example .env
#  .env está en .gitignore: NUNCA subas tu API key a GitHub.
# =============================================================================================

# ---------------------------------------------------------------- IA: chat (OBLIGATORIO)
# DeepSeek (API compatible con OpenAI). Crea la key en https://platform.deepseek.com/api_keys
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-REEMPLAZA-CON-TU-KEY
# deepseek-flash (rápido/económico) | deepseek-v4-pro (más capaz, más caro)
CHAT_MODEL=deepseek-flash
# Vacío = automático: con DeepSeek se envía {"thinking":{"type":"disabled"}} (menos latencia y tokens).
# "none" = no enviar parámetros extra. También puedes poner tu propio JSON.
LLM_EXTRA_BODY_JSON=

# Para usar OpenAI en lugar de DeepSeek:
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_API_KEY=sk-...
#   CHAT_MODEL=gpt-4o-mini
#   (y ajusta los precios de abajo)

# ---------------------------------------------------------------- IA: embeddings del RAG
# DeepSeek no ofrece embeddings. Por defecto: Ollama local (contenedor) con nomic-embed-text (~270 MB).
EMBEDDINGS_BASE_URL=http://ollama:11434/v1
EMBEDDINGS_API_KEY=ollama
EMBEDDING_MODEL=nomic-embed-text
# Para embeddings con OpenAI usa el override docker-compose.openai-embeddings.yml y define:
# OPENAI_API_KEY=sk-...

# ---------------------------------------------------------------- IA: precios (USD por 1M tokens)
# Tarifa PICO de deepseek-flash (conservador; la tarifa valle es la mitad).
# Verifica precios vigentes: https://api-docs.deepseek.com/quick_start/pricing
PRICE_NAME=deepseek-flash (tarifa pico)
PRICE_INPUT_PER_M=0.30
PRICE_CACHED_INPUT_PER_M=0.006
PRICE_OUTPUT_PER_M=1.20
PRICE_EMBEDDING_PER_M=0

# ---------------------------------------------------------------- Infraestructura (solo entorno local)
POSTGRES_PASSWORD=toka_dev_password
RABBITMQ_USER=toka
RABBITMQ_PASSWORD=toka_dev_password
# Contraseña del administrador semilla (admin@toka.local) — solo se aplica en el primer arranque
ADMIN_PASSWORD=Admin123!
OLLAMA_IMAGE_TAG=latest

# ---------------------------------------------------------------- Puertos en el host (cámbialos si están ocupados)
FRONTEND_PORT=3000
GATEWAY_PORT=5000
POSTGRES_PORT=5432
MONGO_PORT=27017
REDIS_PORT=6379
RABBITMQ_UI_PORT=15672
QDRANT_PORT=6333
OLLAMA_PORT=11434
SEQ_PORT=5341
